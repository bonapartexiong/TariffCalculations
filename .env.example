# ---------------------------------------------------------------------------
# Backend environment (copy to .env for local development, or set in your host)
# ---------------------------------------------------------------------------

# --- Semantic matching (chat LLM, e.g. DeepSeek) ---
# LLM_PROVIDER=none (default) disables LLM ranking. Set to "deepseek" to enable.
# DeepSeek exposes an OpenAI-compatible /chat/completions endpoint, so the model
# itself reads the candidates and picks the best match (no embeddings endpoint needed).
LLM_PROVIDER=none
LLM_API_URL=https://api.deepseek.com/v1
# Key (falls back to DEEPSEEK_API_KEY, then OPENAI_API_KEY)
LLM_API_KEY=
# Set this to your model id, e.g. deepseek-chat or deepseek-v4-pro (or the
# provider-specific id such as deepseek-ai/deepseek-v4-pro-0813 on Fireworks).
LLM_MODEL=deepseek-chat
# Number of lexical candidates the LLM ranks per request
LLM_CANDIDATES=10
# LLM_TIMEOUT=60

# --- Semantic matching (embeddings, alternative to the chat LLM) ---
# EMBEDDING_PROVIDER=none uses the free lexical TF-IDF fallback (default).
# Set to "openai" (or any OpenAI-compatible value) to enable embedding matching.
EMBEDDING_PROVIDER=none
# OpenAI-compatible endpoint (works with OpenAI, Azure, Ollama, LM Studio, etc.)
EMBEDDING_API_URL=https://api.openai.com/v1
# API key (falls back to OPENAI_API_KEY if EMBEDDING_API_KEY is unset)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Optional: reduce vector dimension to save memory/cost
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_TIMEOUT=30
# Set true to build the embedding index at startup instead of pre-computing it
# with scripts/build_embeddings.py (recommended for CI).
EMBEDDING_LAZY_BUILD=false

# --- Calculation logging (free by default) ---
# stdout | file | supabase | none
LOGGING_BACKEND=stdout
# LOGGING_FILE_PATH=calculations.jsonl

# --- Optional Supabase persistence (only for LOGGING_BACKEND=supabase) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-anon-key

# --- HTTP ---
ALLOWED_ORIGINS=http://localhost:3000
PORT=5000
FLASK_DEBUG=false

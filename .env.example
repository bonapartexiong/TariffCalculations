# Environment example (no secrets — copy to `.env` and fill in)

# Path to the tariff index JSONL built by scripts/build_index.py
INDEX_PATH=./data/index.jsonl

# Path to the HTS 2026 Rev 21 PDF (sole ground truth)
PDF_PATH=~/workspace/user/files/2026HTSRev21_0_cgh9.pdf

# API port
PORT=5000

# Comma-separated CORS origins (stripped; empty = no CORS headers).
# Example: ALLOWED_ORIGINS=https://example.com,https://app.example.com
ALLOWED_ORIGINS=

# Requests per minute per client IP (0 disables rate limiting)
RATE_LIMIT_PER_MINUTE=60

# CBP fee overrides (EXTERNAL config — not in the HTS PDF).
# Defaults: MPF 0.3464% (0.003464), min $32.71, cap $575; HMF 0.125% (0.00125), ocean-only.
MPF_RATE=0.003464
MPF_MIN=32.71
MPF_CAP=575
HMF_RATE=0.00125
